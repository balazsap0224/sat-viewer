# Cloudflare Pages response headers (module 7). Not used by `pnpm web`.
#
# Built JavaScript and CSS have a content hash in their names, so browsers may keep them for
# good. Everything else (index.html, the data files, textures) keeps Cloudflare's default:
# revalidate on every visit, so new data shows up as soon as a run has deployed it.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
