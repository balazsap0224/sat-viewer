{
  "name": "sat-viewer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "web": "pnpm --filter @sat-viewer/web dev",
    "data": "pnpm --filter @sat-viewer/data-job start",
    "encounters": "pnpm --filter @sat-viewer/data-job encounters",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
